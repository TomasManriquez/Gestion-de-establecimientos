# ============================================================
# .env.production.template
# Copia este archivo a .env en el servidor y rellena los valores.
# NUNCA subas el .env real al repositorio.
# ============================================================

# ─── MongoDB ────────────────────────────────────────────────
MONGO_ROOT_USERNAME=slep_admin
MONGO_ROOT_PASSWORD=CAMBIA_ESTO_por_password_seguro_largo

# ─── Base de datos ──────────────────────────────────────────
DATABASE_NAME=slep_llanquihue

# ─── JWT / Auth ─────────────────────────────────────────────
# Genera uno con: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CAMBIA_ESTO_por_secret_de_128_chars_hexadecimales

# ─── Admin inicial (solo se usa en el primer arranque para seed) ─
ADMIN_PASSWORD=CAMBIA_ESTO_por_password_admin_seguro
# Correo del admin global. Debe pertenecer a ALLOWED_EMAIL_DOMAINS.
BOOTSTRAP_ADMIN_EMAIL=CAMBIA_ESTO_por_correo_del_admin@slepllanquihue.cl

# ─── Identidad ──────────────────────────────────────────────
# Dominios de correo permitidos para los usuarios, separados por comas.
ALLOWED_EMAIL_DOMAINS=slepllanquihue.cl

# ─── Política de contraseñas (NIST SP 800-63B-4) ────────────
PASSWORD_MIN_LENGTH=15
PASSWORD_MAX_LENGTH=64
PASSWORD_REQUIRE_CHAR_CLASSES=0

# ─── App ────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=180

# ─── Backups ────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=7
# ─── Google OAuth2 ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
