# ============================================================
# .env.production.template
# Copia este archivo a .env en el servidor y rellena los valores.
# NUNCA subas el .env real al repositorio.
# ============================================================

# ─── MongoDB ────────────────────────────────────────────────
MONGO_ROOT_USERNAME=slep_admin
MONGO_ROOT_PASSWORD=CAMBIA_ESTO_por_password_seguro_largo

# ─── Base de datos ──────────────────────────────────────────
DATABASE_NAME=slep_llanquihue

# ─── JWT / Auth ─────────────────────────────────────────────
# Mínimo 32 caracteres. Genera uno con: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CAMBIA_ESTO_por_secret_de_128_chars_hexadecimales

# ─── Admin inicial (solo se usa en el primer arranque para seed) ─
ADMIN_PASSWORD=CAMBIA_ESTO_por_password_admin_seguro
# Correo del admin global. Debe pertenecer a ALLOWED_EMAIL_DOMAINS.
BOOTSTRAP_ADMIN_EMAIL=CAMBIA_ESTO_por_correo_del_admin@slepllanquihue.cl

# ─── Identidad ──────────────────────────────────────────────
# Dominios de correo permitidos para los usuarios, separados por comas.
ALLOWED_EMAIL_DOMAINS=slepllanquihue.cl

# ─── Política de contraseñas (NIST SP 800-63B-4) ────────────
PASSWORD_MIN_LENGTH=15
PASSWORD_MAX_LENGTH=64
PASSWORD_REQUIRE_CHAR_CLASSES=0

# ─── App ────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=180

# ─── Backups ────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=7
# ─── Correo (invitaciones y restablecimiento de contraseña) ─
# En producción: MAIL_MODE=smtp (ADR-017). `gmail` es la alternativa (Gmail API, ver Documentacion/07-operacion.md §9.1).
# `console` solo se acepta con PUBLIC_BASE_URL en localhost.
MAIL_MODE=smtp
# Origen público de la aplicación, sin barra final: con él se arma el enlace del correo.
# Con MAIL_MODE=smtp o gmail debe ser https.
PUBLIC_BASE_URL=https://CAMBIA_ESTO_por_el_dominio_publico
# SMTP (MAIL_MODE=smtp), todas obligatorias. Puerto 587 (STARTTLS) o 465 (TLS implícito).
# SMTP_PASSWORD es la contraseña de aplicación de la casilla remitente (cuenta dedicada, con la verificación
# en dos pasos y IMAP deshabilitado). Da acceso SMTP e IMAP: tratarla como JWT_SECRET. Ver 07-operacion.md §9.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_ADDRESS=
# Solo con MAIL_MODE=gmail: casilla remitente y el refresh token de su consentimiento.
# El token da permiso para enviar correo en nombre de la casilla: tratarlo como JWT_SECRET.
GMAIL_SENDER_ADDRESS=
GMAIL_REFRESH_TOKEN=

# ─── Google OAuth2 ─────────────────────────────────────────
# Cliente OAuth (pantalla de consentimiento de tipo Internal). GOOGLE_CLIENT_ID sirve al login con Google;
# con MAIL_MODE=gmail también son obligatorias las dos.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Alta automática (C24): quien entra con Google desde un dominio de ALLOWED_EMAIL_DOMAINS y no tiene
# cuenta obtiene una de lector en `datos`, sin asignar. Cualquier cuenta del dominio (incluidos
# estudiantes y cuentas de servicio). Obligatoria: true o false. Déjala en false hasta que el
# responsable decida activarla (ver Documentacion/07-operacion.md).
GOOGLE_AUTO_PROVISION=false
